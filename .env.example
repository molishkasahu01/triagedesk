# Copy to .env for Docker or production usage
TRIAGEDESK_ENV=development
DATABASE_URL=sqlite:///./triagedesk.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://triagedesk:triagedesk@db:5432/triagedesk
JWT_SECRET_KEY=replace-with-a-random-32-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTO_SEED=true
